---
layout: default
---
<div class="home">
  {% if paginator.page == 1 or paginator == nil %}
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-art" src="{{ '/assets/img/hero/deya-studio.webp' | relative_url }}" alt="A clay-style developer at his laptop, surrounded by Swift and Xcode tools" width="1536" height="1024" fetchpriority="high">
    <div class="hero-copy">
      <p class="eyebrow">A personal blog by Deya Elkhawaldeh</p>
      <h1 id="hero-title">Swift By Deya</h1>
      <p class="hero-description">Insights, ideas, and practical guides on<br class="desktop-break"> Swift, iOS development, and the Apple ecosystem.</p>
      <div class="hero-actions">
        <a class="pill-button primary" href="#articles">Explore Articles {% include default/icon.liquid name="arrow" %}</a>
        <a class="pill-button secondary" href="{{ '/about-me/' | relative_url }}">About Me</a>
      </div>
    </div>
    <div class="hero-benefits">
      <div>{% include default/icon.liquid name="book" %}<span>In-depth tutorials<br>and technical deep dives</span></div>
      <div>{% include default/icon.liquid name="code" %}<span>Real-world lessons<br>from building with Swift</span></div>
      <div>{% include default/icon.liquid name="people" %}<span>A growing community<br>of curious developers</span></div>
    </div>
  </section>
  {% endif %}
  <div class="home-columns">
    <div class="home-feed">
      {% if paginator.page == 1 or paginator == nil %}
      {% assign featured_post = site.posts | where: 'url', site.featured_article | first %}
      {% assign featured_post = featured_post | default: site.posts.first %}
      {% if featured_post %}
      <section class="featured-article" aria-labelledby="featured-title">
        <a class="featured-image" href="{{ featured_post.url | relative_url }}" aria-label="Read {{ featured_post.title | escape }}">
          <img src="{% if site.article_placeholder %}{{ site.article_placeholder | relative_url }}{% else %}{{ featured_post.thumbnail | relative_url }}{% endif %}" alt="" width="640" height="400">
        </a>
        <div class="featured-copy">
          <p class="featured-label"><span aria-hidden="true">★</span> Featured article</p>
          <h2 id="featured-title"><a href="{{ featured_post.url | relative_url }}">{{ featured_post.title }}</a></h2>
          <p class="featured-excerpt">{{ featured_post.excerpt | strip_html | normalize_whitespace | truncatewords: 32 }}</p>
          {% include blog/article_tags.liquid post=featured_post %}
        </div>
        <a class="round-link featured-arrow" href="{{ featured_post.url | relative_url }}" aria-label="Read featured article">{% include default/icon.liquid name="arrow" %}</a>
      </section>
      {% endif %}
      {% endif %}
      <section id="articles" class="latest-articles" aria-labelledby="latest-title">
        <div class="section-heading">
          {% if paginator.page > 1 %}<h1 id="latest-title">More Articles</h1>{% else %}<h2 id="latest-title">Latest Articles</h2>{% endif %}
          <a href="{{ '/archive/' | relative_url }}">View all<span class="desktop-only"> articles</span> {% include default/icon.liquid name="arrow" %}</a>
        </div>
        {% include blog/blog.liquid %}
      </section>
    </div>
    <aside class="home-sidebar" aria-label="About the author and resources">
      <section class="author-card">
        <div class="author-heading">
          <img src="{{ '/assets/img/favicon/deya-face-512.png' | relative_url }}" alt="Cartoon portrait of Deya Elkhawaldeh" width="72" height="72" loading="lazy">
          <div><h2>Deya Elkhawaldeh</h2><p>iOS Developer &amp; Writer</p></div>
        </div>
        <p>I’m Deya, an iOS developer who loves exploring Swift, the Apple ecosystem, and everything in between. I write to share what I learn, document useful techniques, and help make iOS development a little more approachable (and fun!).</p>
        {% include social/profile_links.liquid %}
      </section>
      {% include blog/follow_card.liquid %}
      <section class="resource-card">
        <p class="eyebrow">Keep exploring</p>
        <a href="{{ '/books/' | relative_url }}">Books by Deya {% include default/icon.liquid name="arrow" %}</a>
        <a href="{{ '/ios-road-map/' | relative_url }}">Your Swift roadmap {% include default/icon.liquid name="arrow" %}</a>
        <a href="{{ '/tag/' | relative_url }}">Browse all topics {% include default/icon.liquid name="arrow" %}</a>
      </section>
    </aside>
  </div>
</div>

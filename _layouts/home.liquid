---
layout: default
---
<div class="home">
  {% include default/hero.liquid %}
  <div class="home-columns">
    <div class="home-feed">
      {% if paginator.page == 1 or paginator == nil %}
      {% assign featured_post = site.posts | where: 'url', site.featured_article | first %}
      {% assign featured_post = featured_post | default: site.posts.first %}
      {% if featured_post %}
      <section class="featured-article" aria-labelledby="featured-title">
        <a class="featured-image" href="{{ featured_post.url | relative_url }}" aria-label="Read {{ featured_post.title | escape }}">
          <img src="{% if site.article_placeholder and featured_post.thumbnail_ready != true %}{{ site.article_placeholder | relative_url }}{% else %}{{ featured_post.thumbnail | relative_url }}{% endif %}" alt="" width="640" height="400">
        </a>
        <div class="featured-copy">
          <p class="featured-label"><span aria-hidden="true">★</span> Featured article</p>
          <h2 id="featured-title"><a href="{{ featured_post.url | relative_url }}">{{ featured_post.title }}</a></h2>
          <p class="featured-excerpt">{{ featured_post.excerpt | strip_html | normalize_whitespace | truncatewords: 32 }}</p>
          {% include blog/article_tags.liquid post=featured_post %}
        </div>
        <a class="round-link featured-arrow" href="{{ featured_post.url | relative_url }}" aria-label="Read featured article">{% include default/icon.liquid name="arrow" %}</a>
      </section>
      {% endif %}
      {% endif %}
      <section id="articles" class="latest-articles" aria-labelledby="latest-title">
        <div class="section-heading">
          <h2 id="latest-title">{% if paginator.page > 1 %}More Articles{% else %}Latest Articles{% endif %}</h2>
          <a href="{{ '/archive/' | relative_url }}"><span>View all<span class="desktop-only"> articles</span></span>{% include default/icon.liquid name="arrow" %}</a>
        </div>
        {% include blog/blog.liquid %}
      </section>
    </div>
    <aside class="home-sidebar" aria-label="About the author and resources">
      <section class="author-card">
        <div class="author-heading">
          <img src="{{ '/assets/img/author/deya-avatar.webp' | relative_url }}" alt="Cartoon portrait of Deya Elkhawaldeh with a close buzz cut and glasses" width="72" height="72" loading="lazy">
          <div><h2>Deya Elkhawaldeh</h2><p>iOS Developer &amp; Writer</p></div>
        </div>
        <p>I’m Deya, an iOS developer who loves exploring Swift, the Apple ecosystem, and everything in between. I write to share what I learn, document useful techniques, and help make iOS development a little more approachable (and fun!).</p>
        {% include social/profile_links.liquid %}
      </section>
      <section class="book-promo" aria-labelledby="book-promo-title">
        <p class="eyebrow">My book</p>
        <a class="book-promo-cover" href="{{ '/books/' | relative_url }}" tabindex="-1" aria-hidden="true">
          <img src="{{ '/images/books/ios_security_through_defensive_techniques.jpg' | relative_url }}" alt="" width="1216" height="1500" loading="lazy">
        </a>
        <h2 id="book-promo-title"><a href="{{ '/books/' | relative_url }}">iOS Security Through Defensive Techniques</a></h2>
        <p>A practical guide to protecting your apps against insecure storage, reverse engineering, and runtime tampering.</p>
        <a class="book-cta" href="https://www.amazon.com/iOS-Security-Through-Defensive-Techniques-ebook/dp/B0FWYY4YH9">Buy the book</a>
      </section>
      {% include blog/follow_card.liquid %}
    </aside>
  </div>
</div>

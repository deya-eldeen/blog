---
layout: page
---
{% assign posts_by_year = site.posts | group_by_exp: 'post', "post.date | date: '%Y'" %}
<p class="index-intro">A collection of ideas, discoveries, and practical guides from my journey with Swift and iOS.</p>
<ul class="topic-cloud">
  {% for year in posts_by_year %}<li><a href="#archive-{{ year.name }}">{{ year.name }}<span>{{ year.items.size }}</span></a></li>{% endfor %}
</ul>
{% for year in posts_by_year %}
<section class="index-group" aria-labelledby="archive-{{ year.name }}">
  <h2 id="archive-{{ year.name }}">{{ year.name }}<span>{{ year.items.size }} {% if year.items.size == 1 %}article{% else %}articles{% endif %}</span></h2>
  {% for post in year.items %}
  <a class="index-link" href="{{ post.url | relative_url }}"><span>{{ post.title }}</span><time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %-d, %Y' }}</time></a>
  {% endfor %}
</section>
{% endfor %}

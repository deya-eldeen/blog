---
layout: page
---
<p class="index-intro">Follow your curiosity, one topic at a time.</p>
{% assign tagged_documents = site.posts | concat: site.pages | concat: site.portfolio %}
{% assign all_tags = tagged_documents | map: 'tags' | join: '|' | split: '|' | uniq | sort %}
<ul class="topic-cloud">
  {% for tag in all_tags %}{% unless tag == '' %}<li><a href="#{{ tag | cgi_escape }}">{{ tag }}</a></li>{% endunless %}{% endfor %}
</ul>
{% for tag in all_tags %}
{% unless tag == '' %}
<section class="index-group" aria-labelledby="{{ tag | cgi_escape }}">
  <h2 id="{{ tag | cgi_escape }}">{{ tag }}</h2>
  {% for item in tagged_documents %}
    {% if item.tags contains tag %}
    <a class="index-link" href="{{ item.url | relative_url }}"><span>{{ item.title }}</span>{% if item.date %}<time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %-d, %Y' }}</time>{% endif %}</a>
    {% endif %}
  {% endfor %}
</section>
{% endunless %}
{% endfor %}

---
layout: page
---
<p class="index-intro">Find your next deep dive. Explore articles by the subjects that interest you.</p>
{% assign sorted_categories = site.categories | sort %}
<ul class="topic-cloud">
  {% for category in sorted_categories %}<li><a href="#category-{{ category[0] | slugify }}">{{ category[0] }}<span>{{ category[1].size }}</span></a></li>{% endfor %}
</ul>
{% for category in sorted_categories %}
<section class="index-group" aria-labelledby="category-{{ category[0] | slugify }}">
  <h2 id="category-{{ category[0] | slugify }}">{{ category[0] }}<span>{{ category[1].size }} articles</span></h2>
  {% for post in category[1] %}
  <a class="index-link" href="{{ post.url | relative_url }}"><span>{{ post.title }}</span><time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %-d, %Y' }}</time></a>
  {% endfor %}
</section>
{% endfor %}

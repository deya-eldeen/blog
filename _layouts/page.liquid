---
layout: default
---
{% if page.show_hero %}
  {% assign hero_articles_url = '/' | relative_url | append: '#articles' %}
  {% include default/hero.liquid primary_url=hero_articles_url image=page.hero_image image_alt=page.hero_image_alt %}
{% endif %}
<article class="document page-document">
  {% unless page.hide_title %}
  <header class="document-header">
    <p class="eyebrow">Swift By Deya · {{ page.title }}</p>
    {% if page.show_hero %}
    <h2 id="{{ page.title | cgi_escape }}">{{ page.title }}</h2>
    {% else %}
    <h1 id="{{ page.title | cgi_escape }}">{{ page.title }}</h1>
    {% endif %}
    {% if page.subtitle %}<p class="subtitle">{{ page.subtitle }}</p>{% endif %}
  </header>
  {% endunless %}
  <div class="post-content">
    {% if page.bootstrap %}<div class="bootstrap-iso">{% endif %}
    {{ content }}
    {% if page.bootstrap %}</div>{% endif %}
  </div>
  {% unless page.hide_tags %}
    {% capture tag_list %}{{ page.tags | join: "|" }}{% endcapture %}
    {% include default/tags_list.liquid tags=tag_list %}
  {% endunless %}
</article>

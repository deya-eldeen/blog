<section class="follow-card">
  <span class="follow-icon">{% include default/icon.liquid name="rss" %}</span>
  <div class="follow-copy">
    <h2>A little Swift.<br> A fresh perspective.</h2>
    <p>Practical Swift &amp; iOS insights, straight to your favorite feed reader.</p>
    <a class="feed-button" href="{{ '/feed.xml' | relative_url }}">Follow new articles <span class="round-link">{% include default/icon.liquid name="arrow" %}</span></a>
  </div>
  <span class="envelope" aria-hidden="true">{% include default/icon.liquid name="mail" %}</span>
</section>

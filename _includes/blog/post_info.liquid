{% assign author = site.data.authors[include.author] %}
<div class="post-info">
  {% if author.avatar %}<img alt="" src="{{ author.avatar | relative_url }}" width="30" height="30" loading="lazy">{% endif %}
  <p>{% if author.name %}{{ author.name }} <span aria-hidden="true">·</span> {% endif %}<time datetime="{{ include.date | date_to_xmlschema }}">{{ include.date | date: '%B %-d, %Y' }}</time></p>
</div>

{% assign latest_posts = paginator.posts | default: site.posts %}
<div class="article-grid">
  {% for post in latest_posts %}
    {% unless post.url == featured_post.url %}
      {% include blog/article_card.liquid post=post %}
    {% endunless %}
  {% else %}
    <p>New articles are on their way. Check back soon!</p>
  {% endfor %}
</div>
{% include blog/blog_nav.liquid %}

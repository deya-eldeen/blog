{% assign card_post = include.post %}
{% assign reading_minutes = card_post.content | strip_html | number_of_words | plus: 219 | divided_by: 220 | at_least: 1 %}
<article class="article-card">
  <a class="article-image" href="{{ card_post.url | relative_url }}" aria-label="Read {{ card_post.title | escape }}">
    <img src="{% if site.article_placeholder and card_post.thumbnail_ready != true %}{{ site.article_placeholder | relative_url }}{% else %}{{ card_post.thumbnail | relative_url }}{% endif %}" alt="" width="640" height="400" loading="lazy">
  </a>
  <div class="article-copy">
    <h3><a href="{{ card_post.url | relative_url }}">{{ card_post.title }}</a></h3>
    <p class="article-excerpt">{{ card_post.excerpt | strip_html | normalize_whitespace | truncatewords: 22 }}</p>
    {% include blog/article_tags.liquid post=card_post %}
    <p class="article-meta"><time datetime="{{ card_post.date | date_to_xmlschema }}">{{ card_post.date | date: '%b %-d, %Y' }}</time><span aria-hidden="true">·</span>{{ reading_minutes }} min read</p>
  </div>
  <a class="round-link article-arrow" href="{{ card_post.url | relative_url }}" aria-label="Read {{ card_post.title | escape }}">{% include default/icon.liquid name="chevron" %}</a>
</article>

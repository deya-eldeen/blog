{%- assign guide = nil -%}
{%- assign progress = nil -%}
{%- if include.url -%}
{%- assign guide = site.pages | where: "url", include.url | first -%}
{%- assign progress = guide.roadmap_progress -%}
<a class="roadmap-card" href="{{ include.url | relative_url }}">
{%- else -%}
<div class="roadmap-card roadmap-card-soon">
{%- endif -%}
{%- include roadmap/art.liquid name=include.art -%}
<span class="roadmap-card-copy"><span class="roadmap-card-title">{{ include.title }}</span><span class="roadmap-card-text">{{ include.text }}</span>
{%- if progress and progress.total > 0 -%}
{%- assign percent = progress.done | times: 100 | divided_by: progress.total -%}
{%- if progress.done > 0 and percent < 3 -%}{%- assign percent = 3 -%}{%- endif -%}
<span class="roadmap-progress"><span class="roadmap-progress-track" aria-hidden="true"><span class="roadmap-progress-fill" style="width: {{ percent }}%"></span></span><span class="roadmap-progress-label">{{ progress.done }} / {{ progress.total }} topics written</span></span>
{%- endif -%}
{%- unless include.url -%}<span class="roadmap-soon">Coming soon</span>{%- endunless -%}</span>
{%- if include.url -%}
</a>
{%- else -%}
</div>
{%- endif -%}

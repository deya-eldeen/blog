{% assign tags = include.tags | split: '|' | sort | uniq %}
{% if tags.size > 0 %}
<div class="tag-list">
  <ul>
    <li class="meta">Topics</li>
    {% for tag in tags %}
    {% unless tag == '' %}<li><a href="{{ '/tag/' | relative_url }}#{{ tag | cgi_escape }}">{{ tag }}</a></li>{% endunless %}
    {% endfor %}
  </ul>
</div>
{% endif %}

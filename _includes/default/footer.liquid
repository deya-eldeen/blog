<footer class="site-footer">
  <div class="footer-inner">
    <div><a class="footer-brand" href="{{ '/' | relative_url }}">Swift By Deya</a><p>Stay curious. Keep building.</p></div>
    <nav aria-label="Footer navigation">
      <a href="{{ '/archive/' | relative_url }}">Archive</a>
      <a href="{{ '/tag/' | relative_url }}">Tags</a>
      <a href="{{ '/category/' | relative_url }}">Categories</a>
      <a href="{{ '/feed.xml' | relative_url }}">RSS</a>
    </nav>
    <p class="copyright">© {{ site.time | date: '%Y' }} Deya Elkhawaldeh</p>
  </div>
  {% if site.mermaid %}
    <script type="module">
      mermaid.initialize({ startOnLoad: false, theme: "default" });
      mermaid.run({ nodes: [...document.querySelectorAll('.language-mermaid'), ...document.querySelectorAll('.mermaid')] });
    </script>
  {% endif %}
</footer>

{% assign hero_image = '/assets/img/hero/deya-studio.webp' %}
{% assign hero_alt = 'A clay-style developer at his laptop, surrounded by Swift and Xcode tools' %}
{% if include.image %}
  {% assign hero_image_file = site.static_files | where: 'path', include.image | first %}
  {% if hero_image_file %}
    {% assign hero_image = include.image %}
    {% assign hero_alt = include.image_alt | default: hero_alt %}
  {% endif %}
{% endif %}
<section class="hero" aria-labelledby="hero-title">
  <img class="hero-art" src="{{ hero_image | relative_url }}" alt="{{ hero_alt }}" width="1536" height="1024" fetchpriority="high">
  <div class="hero-copy">
    <p class="eyebrow">A personal blog by Deya Elkhawaldeh</p>
    <h1 id="hero-title">Swift By Deya</h1>
    <p class="hero-description">Insights, ideas, and practical guides on<br class="desktop-break"> Swift, iOS development, and the Apple ecosystem.</p>
    {% unless include.hide_actions %}
    <div class="hero-actions">
      <a class="pill-button primary" href="{{ include.primary_url | default: '#articles' }}">{{ include.primary_label | default: 'Explore Articles' }} {% include default/icon.liquid name="arrow" %}</a>
    </div>
    {% endunless %}
  </div>
  <div class="hero-benefits">
    <div>{% include default/icon.liquid name="book" %}<span>In-depth tutorials<br>and technical deep dives</span></div>
    <div>{% include default/icon.liquid name="code" %}<span>Real-world lessons<br>from building with Swift</span></div>  </div>
</section>

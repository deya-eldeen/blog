<header class="site-header">
  <div class="header-inner">
    <a class="branding" href="{{ '/' | relative_url }}" aria-label="Swift By Deya home">
      <span class="site-title">{{ site.title }}</span>
    </a>
    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      <a href="{{ '/' | relative_url }}" {% if page.layout == 'home' %}aria-current="page"{% endif %}>Home</a>
      <a href="{{ '/category/' | relative_url }}" {% if page.layout == 'categories' %}aria-current="page"{% endif %}>Categories</a>
      <a href="{{ '/books/' | relative_url }}" {% if page.url == '/books/' %}aria-current="page"{% endif %}>Books</a>
      <a href="{{ '/portfolio/' | relative_url }}" {% if page.url == '/portfolio/' %}aria-current="page"{% endif %}>Portfolio</a>
      <a href="{{ '/archive/' | relative_url }}" {% if page.layout == 'archive' or page.layout == 'post' %}aria-current="page"{% endif %}>Archive</a>
      <a href="{{ '/about-me/' | relative_url }}" {% if page.url == '/about-me/' %}aria-current="page"{% endif %}>About</a>
      <div class="mobile-resources">
        <a href="{{ '/ios-road-map/' | relative_url }}">Swift roadmaps</a>
        <a href="{{ '/tag/' | relative_url }}">Tags</a>
        <button class="mobile-theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">Toggle appearance</button>
      </div>
    </nav>
    <div class="header-actions">
      <a class="header-search" href="{{ '/search/' | relative_url }}" aria-label="Search articles">
        {% include default/icon.liquid name="search" %}<span>Search articles…</span><kbd>⌘ K</kbd>
      </a>
      <button class="icon-button theme-toggle" id="theme-toggle" data-theme-toggle type="button" aria-label="Switch to dark theme" aria-pressed="false">
        {% include default/icon.liquid name="sun" %}
      </button>
      <button class="icon-button menu-toggle" id="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
        {% include default/icon.liquid name="menu" %}
      </button>
    </div>
  </div>
</header>
